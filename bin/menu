#!/bin/bash
source /etc/tiendassh/assets/theme.conf 2>/dev/null || source ./assets/theme.conf 2>/dev/null

BASE_DIR="/etc/tiendassh"
if [ ! -d "$BASE_DIR" ]; then BASE_DIR="."; fi

while true; do
    clear
    if [ -f "$BASE_DIR/assets/logo.txt" ]; then
        echo -e "${NEON_BLUE}"; cat "$BASE_DIR/assets/logo.txt"; echo -e "${NC}"
    else
        echo -e "${NEON_BLUE}==========================================${NC}"
        echo -e "${NEON_GREEN}            ⚡ TIENDASSH ⚡${NC}"
        echo -e "${NEON_BLUE}==========================================${NC}"
    fi
    ip_pub=$(curl -s -m 2 ifconfig.me 2>/dev/null || echo "127.0.0.1")
    key_val=$(cat /etc/tiendassh/key.txt 2>/dev/null || echo "N/A")
    mem_used=$(free -m 2>/dev/null | awk '/Mem:/ {print $3"MB / "$2"MB"}')
    echo -e "${WHITE}IP pública:${NC} ${NEON_YELLOW}$ip_pub${NC} | ${WHITE}RAM:${NC} ${NEON_GREEN}$mem_used${NC}"
    echo -e "${WHITE}KEY actual:${NC} ${NEON_PINK}$key_val${NC}"
    echo -e "${NEON_BLUE}====================================================================${NC}"
    echo -e "${WHITE}[1]${NC} 👥 Administración de Usuarios (HWID/SSH)"
    echo -e "${WHITE}[2]${NC} 🌐 Administrador de Protocolos"
    echo -e "${WHITE}[3]${NC} 🔒 Iniciar Túnel Seguro (DTunel)"
    echo -e "${WHITE}[4]${NC} 🤖 Gestión de Bots Telegram"
    echo -e "${WHITE}[5]${NC} 💻 Herramientas de Sistema"
    echo -e "${WHITE}[6]${NC} 🔄 Actualizar TiendaSSH"
    echo -e "${WHITE}[0]${NC} ❌ Salir"
    echo -e "${NEON_BLUE}====================================================================${NC}"
    read -r -p "Selecciona una opción: " opt
    case $opt in
        1) bash "$BASE_DIR/modules/users.sh" ;;
        2) bash "$BASE_DIR/modules/protocols.sh" ;;
        3) bash "$BASE_DIR/bin/dtunel"; read -r -p "Presiona Enter..." ;;
        4) bash "$BASE_DIR/modules/bots.sh" ;;
        5) bash "$BASE_DIR/modules/system.sh" ;;
        6) tiendassh update; read -r -p "Presiona Enter..." ;;
        0) echo -e "${NEON_GREEN}¡Gracias por usar TiendaSSH!${NC}"; break ;;
        *) echo -e "${RED}❌ Opción inválida${NC}"; sleep 1 ;;
    esac
done
